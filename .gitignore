# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.Python
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# File gốc - có thể có bản quyền, không cần version control
input/

# Working - CHỈ exclude 3 thư mục file to/tái tạo được
# working/summary/ và working/progress/ là tài sản tích lũy, COMMIT vào git
working/extracted/
working/chunks/
working/qa/
# Riêng working/<slug>/ cấp con cũng loại (tránh sót)
working/extracted/*
working/chunks/*
working/qa/*

# Generated glossary prompts
working/glossary_prompt*.txt
# Chunk cache audiobook (WAV tạm) — tái tạo được, không commit
working/progress_audio/chunks/
# venv audiobook (VieNeu-TTS)
working/venv-vieneu/

# Audio mẫu + reference voices dùng chung — KHÔNG commit (có thể có bản quyền)
core/

# Công cụ (ffmpeg) — tải riêng, không commit
tools/

# WAV trung gian audiobook (48kHz, ~52MB/chương) — chỉ commit MP3
output/**/*.wav

# Thư mục test legacy edge-tts — không commit
output/**/audio_test/

# Logs
*.log
logs/

# MinerU
.magic_pdf/
minerU_cache/
models/
*.pdf.cache

# Test files
test_*
!tests/test_*
!tests/test_epub_data/
!tests/test_epub_data/*.md

tmp/
temp/

# OneDrive sync conflict files
*DESKTOP-*
*CONFLICT*
*(*conflict*)*
