# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.Python
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# File gốc - có thể có bản quyền, không cần version control
input/

# Sản phẩm dịch + glossary — KHÔNG commit (repo chỉ giữ CODE). Giữ local/Drive.
output/
glossary/

# Working — toàn bộ thư mục làm việc (venv, backup, sản phẩm trung gian) KHÔNG commit
working/
# Giữ các rule cũ (tường minh hơn, tránh sót)
working/extracted/
working/chunks/
working/qa/
# Riêng working/<slug>/ cấp con cũng loại (tránh sót)
working/extracted/*
working/chunks/*
working/qa/*
# Sản phẩm tích lũy (chunk đã dịch, progress, tiến độ audiobook) — KHÔNG commit
working/progress/
working/progress_audio/

# Generated glossary prompts
working/glossary_prompt*.txt
# Thư mục working lạc (sinh khi path PROJECT_ROOT lệch)
scripts/process/working/
# venv audiobook (VieNeu-TTS)
working/venv-vieneu/

# Audio mẫu + reference voices dùng chung — KHÔNG commit (có thể có bản quyền)
core/

# Công cụ (ffmpeg) — tải riêng, không commit
tools/

# WAV trung gian audiobook (48kHz, ~52MB/chương) — chỉ commit MP3
output/**/*.wav

# Binary nặng — TEXT-ONLY: không commit audio/ebook, chỉ giữ text + tiến độ
output/**/*.mp3
output/**/*.epub

# Thư mục test samples (tạo khi test giọng)
output/samples/

# Thư mục archive legacy
output/_archive/

# Thư mục test legacy edge-tts — không commit
output/**/audio_test/

# Logs
*.log
*.log.err
logs/

# MinerU
.magic_pdf/
minerU_cache/
models/
*.pdf.cache

# Test files
test_*
!tests/test_*
!tests/test_epub_data/
!tests/test_epub_data/*.md

tmp/
temp/

# OneDrive sync conflict files
*DESKTOP-*
*CONFLICT*
*(*conflict*)*
