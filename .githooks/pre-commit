#!/usr/bin/env python
"""Pre-commit hook: kiểm tra cú pháp Python của tất cả script trước khi commit.

Cách dùng:
    git config core.hooksPath .githooks
    
Sau đó mỗi lần `git commit`, hook này sẽ chạy `python -m py_compile` trên
từng file .py trong scripts/ để bắt lỗi cú pháp trước khi commit.
"""

import subprocess
import sys
from pathlib import Path


def main():
    repo_root = Path(__file__).resolve().parent.parent
    scripts_dir = repo_root / "scripts"

    if not scripts_dir.is_dir():
        sys.exit(0)

    errors = []
    for py_file in sorted(scripts_dir.glob("*.py")):
        result = subprocess.run(
            [sys.executable, "-m", "py_compile", str(py_file)],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            errors.append((py_file.name, result.stderr.strip()))

    if errors:
        print("\n❌ LỖI CÚ PHÁP — Commit bị hủy:")
        for name, msg in errors:
            print(f"  • {name}: {msg.split(chr(10))[-1]}")
        print("\nSửa lỗi rồi commit lại.")
        sys.exit(1)


if __name__ == "__main__":
    main()
