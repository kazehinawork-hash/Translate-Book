<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fluent Light Colors -->
    <Color x:Key="AccentColor">#005FB8</Color>
    <Color x:Key="BgAppColor">#F3F3F3</Color>
    <Color x:Key="BgCardColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E5E5E5</Color>
    <Color x:Key="HoverColor">#F3F3F3</Color>
    <Color x:Key="PressedColor">#EDEDED</Color>
    <Color x:Key="TextPrimaryColor">#000000</Color>
    <Color x:Key="TextSecondaryColor">#606060</Color>
    <Color x:Key="SuccessColor">#107C10</Color>
    
    <Color x:Key="InputBgColor">#FFFFFF</Color>
    <Color x:Key="ButtonHoverColor">#10000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BgAppBrush" Color="{StaticResource BgAppColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}"/>
</ResourceDictionary>
