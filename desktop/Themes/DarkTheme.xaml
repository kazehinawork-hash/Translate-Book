<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fluent Dark Colors -->
    <Color x:Key="AccentColor">#60CDFF</Color>
    <Color x:Key="BgAppColor">#202020</Color>
    <Color x:Key="BgCardColor">#2D2D2D</Color>
    <Color x:Key="BorderColor">#333333</Color>
    <Color x:Key="HoverColor">#3E3E3E</Color>
    <Color x:Key="PressedColor">#2A2A2A</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#A0A0A0</Color>
    <Color x:Key="SuccessColor">#6CCB5F</Color>
    
    <Color x:Key="InputBgColor">#1A1A1A</Color>
    <Color x:Key="ButtonHoverColor">#33FFFFFF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BgAppBrush" Color="{StaticResource BgAppColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}"/>
</ResourceDictionary>
