<Page x:Class="TranslateBook.Views.BooksPage"
        x:Name="BooksPageRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:TranslateBook.Models"
        Loaded="Page_Loaded"
        ScrollViewer.CanContentScroll="False">

    <Grid Margin="12,8,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Danh sách sách" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>

            <!-- Dashboard Analytics Quick Bar -->
            <Border Grid.Column="1" Margin="20,0,16,0" Padding="12,4" HorizontalAlignment="Left"
                    Background="{DynamicResource GlassElementBackground2Brush}"
                    BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                    CornerRadius="10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Sách chưa làm -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" ToolTip="Số lượng sách trong input/chua-lam/">
                        <ui:SymbolIcon Symbol="BookClock24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0"/>
                        <TextBlock Text="Chưa làm: " FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding PendingBooksCount}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="•" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,12,0"/>
                    <!-- Sách đã dịch -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" ToolTip="Tổng số sách đã dịch hoàn tất">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,4,0"/>
                        <TextBlock Text="Đã dịch: " FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding TranslatedBooksCount}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                    </StackPanel>
                    <TextBlock Text="•" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,12,0"/>
                    <!-- Sách có Audio -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" ToolTip="Số sách đã có Audiobook hoàn tất">
                        <ui:SymbolIcon Symbol="Headphones24" FontSize="14" Foreground="#e082ff" Margin="0,0,4,0"/>
                        <TextBlock Text="Audio: " FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding AudioBooksCount}" FontSize="11.5" FontWeight="Bold" Foreground="#e082ff"/>
                    </StackPanel>
                    <TextBlock Text="•" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,12,0"/>
                    <!-- Tốc độ GPU TTS -->
                    <StackPanel Orientation="Horizontal" ToolTip="Tốc độ xử lý của engine VieNeu-TTS v3 Turbo với GPU RTX">
                        <ui:SymbolIcon Symbol="Flash24" FontSize="14" Foreground="#40c4ff" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding GpuPerformanceText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#40c4ff"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ui:Button Grid.Column="2" Width="36" Height="36"
                       Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Làm mới danh sách sách" Cursor="Hand"
                       Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                       Command="{Binding RefreshBooksCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Glass 3.0 tab headers + Concurrency Selector container -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <Border DockPanel.Dock="Left" Padding="4"
                        Background="{DynamicResource GlassElementBackground2Brush}"
                        BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                        CornerRadius="14">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabInput" Content="Input (Chưa dịch)" IsChecked="True"
                                     Click="TabInput_Click" GroupName="BookTabs" Margin="0,0,4,0"
                                     Style="{StaticResource GlassTabHeader}"/>
                        <RadioButton x:Name="TabOutput" Content="Output (Đã dịch)"
                                     Click="TabOutput_Click" GroupName="BookTabs"
                                     Style="{StaticResource GlassTabHeader}"/>
                    </StackPanel>
                </Border>

                <!-- Bộ điều chỉnh tốc độ dịch đa luồng thông minh -->
                <Border DockPanel.Dock="Right" Padding="10,4"
                        Background="{DynamicResource GlassElementBackground2Brush}"
                        BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                        CornerRadius="14" VerticalAlignment="Center"
                        ToolTip="Cơ chế Dịch Song Song Thông Minh: Tự động trích xuất Ngữ cảnh Gối đầu (Sliding Window Context) &amp; Hồ sơ văn chương để bản dịch luôn liền mạch 100%">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Flash24" FontSize="14" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Luồng dịch:" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="150" Height="28" FontSize="11.5"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding TranslateConcurrency, Mode=TwoWay}"
                                  Style="{StaticResource GlassComboBox}">
                            <ComboBoxItem Content="1 Luồng (An toàn Free)" Tag="1"/>
                            <ComboBoxItem Content="2 Luồng (Khuyên dùng)" Tag="2"/>
                            <ComboBoxItem Content="3 Luồng (Nhanh)" Tag="3"/>
                            <ComboBoxItem Content="4 Luồng (Key trả phí)" Tag="4"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Input Book List Container with elegant rounded glass border -->
            <Border Grid.Row="1" x:Name="InputPanel" Visibility="Visible"
                    Background="{DynamicResource GlassElementBackground2Brush}"
                    BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                    CornerRadius="12" Padding="8" Margin="0,0,0,8">
                <ScrollViewer x:Name="InputScrollViewer" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InputBooks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="📚" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Chưa có sách nào để dịch."
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Copy file .pdf, .epub hoặc .docx vào thư mục input/ rồi bấm Làm mới."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,16"/>
                            <ui:Button Content="Mở thư mục input" Icon="{ui:SymbolIcon Folder24}"
                                       HorizontalAlignment="Center" Padding="16,6" Cursor="Hand"
                                       Click="OpenInputFolder_Click"/>
                        </StackPanel>
                        <ItemsControl x:Name="InputItemsControl" ItemsSource="{Binding InputBooks}" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:BookStatus}">
                                <ui:Card Margin="6" Width="320" Padding="16" Style="{StaticResource InteractiveCard}"
                                         Tag="{Binding DataContext, ElementName=BooksPageRoot}">
                                    <ui:Card.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Mở thư mục sách"
                                                      Icon="{ui:SymbolIcon Folder24}"
                                                      Command="{Binding Path=PlacementTarget.Tag.OpenBookFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ContextMenuOpenFolder_Click"/>
                                            <MenuItem Header="Đọc thử bản dịch (Preview)"
                                                      Icon="{ui:SymbolIcon Eye24}"
                                                      Command="{Binding Path=PlacementTarget.Tag.PreviewTranslatedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ContextMenuPreview_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Sao chép đường dẫn file"
                                                      Icon="{ui:SymbolIcon Copy24}"
                                                      Command="{Binding Path=PlacementTarget.Tag.CopyBookPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ContextMenuCopyPath_Click"/>
                                            <MenuItem Header="Dọn dẹp cache trung gian"
                                                      Icon="{ui:SymbolIcon Broom24}"
                                                      Command="{Binding Path=PlacementTarget.Tag.CleanBookCacheCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ContextMenuCleanCache_Click"/>
                                        </ContextMenu>
                                    </ui:Card.ContextMenu>
                                    <StackPanel>
                                        <!-- Header: avatar + title + status -->
                                        <Border Style="{StaticResource BookCardHeader}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="21"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding InputCategory, StringFormat='Vị trí: input/{0}'}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Khung Dịch test thử theo chương (Test chất lượng trước) -->
                                        <Border Margin="0,8,0,10" Padding="10" CornerRadius="10"
                                                Background="{DynamicResource GlassElementBackgroundBrush}"
                                                BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.5">
                                            <StackPanel>
                                                <TextBlock Text="⚡ Dịch test thử theo chương:" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ChapterCombo" Grid.Column="0" Height="32" FontSize="11.5"
                                                              ItemsSource="{Binding AvailableChapters}"
                                                              SelectedItem="{Binding SelectedSampleChapter, Mode=TwoWay}"
                                                              ToolTip="Chọn chương muốn dịch test thử"
                                                              IsEditable="False"
                                                              Loaded="ChapterCombo_Loaded"
                                                              Style="{StaticResource GlassComboBox}"/>
                                                    <ui:Button Grid.Column="2" Content="Dịch test" Icon="{ui:SymbolIcon PlayCircle24}"
                                                               Height="32" Padding="12,0" FontSize="12"
                                                               ToolTip="Dịch test thử chương đã chọn qua API và mở cửa sổ xem trước (Preview)"
                                                               Click="SampleTranslate_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                <!-- Nút chạy Dịch toàn bộ cuốn sách & Sửa chữa -->
                                <StackPanel Margin="0,2,0,0">
                                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                                               Content="Dịch Toàn bộ" Height="34" HorizontalAlignment="Stretch"
                                               ToolTip="Chạy toàn bộ quy trình dịch từ đầu: Trích xuất → Chia chunk → Tạo khung → Dịch mới → Merge → EPUB"
                                               Click="RunPipeline_Click">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Content" Value="Đang chạy toàn bộ..."/>
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Wrench24}" Margin="0,6,0,0"
                                               Content="Sửa chữa &amp; Rà soát" Height="34" HorizontalAlignment="Stretch"
                                               ToolTip="Chế độ thông minh: Rà soát lỗi từng chunk, giữ lại các chunk đã tốt, chỉ dịch lại các chunk lỗi/lệch dòng và tự động gộp lại file thành phẩm"
                                               Click="RepairBook_Click">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Content" Value="Đang rà soát &amp; sửa..."/>
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>

                                        <!-- Progress area with GlassProgressBar + realtime percentage -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Progress info bar -->
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"
                                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            </Grid>

                                            <!-- Glowing Glass Progress Bar -->
                                            <ProgressBar Grid.Row="1" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                                         Style="{StaticResource GlassProgressBar}" Height="7"/>

                                            <!-- Sub details / Step counter -->
                                            <TextBlock Grid.Row="2" Text="{Binding BusyDetailText}"
                                                       FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </Grid>
                                        <ui:Button Content="Hủy" Icon="{ui:SymbolIcon Dismiss24}" Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" Padding="12,2"
                                                   Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Output Book List Container with elegant rounded glass border -->
            <Border Grid.Row="1" x:Name="OutputPanel" Visibility="Collapsed"
                    Background="{DynamicResource GlassElementBackground2Brush}"
                    BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                    CornerRadius="12" Padding="8" Margin="0,0,0,8">
                <ScrollViewer x:Name="OutputScrollViewer" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OutputBooks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="✅" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Chưa có sách nào được dịch xong."
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Chuyển sang tab Input để bắt đầu dịch sách mới."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                    <ItemsControl x:Name="OutputItemsControl" ItemsSource="{Binding OutputBooks}" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:BookStatus}">
                                <ui:Card Margin="6" Width="340" Style="{StaticResource InteractiveCard}"
                                         Tag="{Binding DataContext, ElementName=BooksPageRoot}">
                                    <ui:Card.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Mở thư mục sách"
                                                      Icon="{ui:SymbolIcon Folder24}"
                                                      Command="{Binding Path=PlacementTarget.Tag.OpenBookFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ContextMenuOpenFolder_Click"/>
                                            <MenuItem Header="Đọc thử bản dịch (Preview)"
                                                      Icon="{ui:SymbolIcon Eye24}"
                                                      Command="{Binding Path=PlacementTarget.Tag.PreviewTranslatedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ContextMenuPreview_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Sao chép đường dẫn thư mục"
                                                      Icon="{ui:SymbolIcon Copy24}"
                                                      Command="{Binding Path=PlacementTarget.Tag.CopyBookPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ContextMenuCopyPath_Click"/>
                                            <MenuItem Header="Dọn dẹp cache trung gian"
                                                      Icon="{ui:SymbolIcon Broom24}"
                                                      Command="{Binding Path=PlacementTarget.Tag.CleanBookCacheCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ContextMenuCleanCache_Click"/>
                                        </ContextMenu>
                                    </ui:Card.ContextMenu>
                                    <StackPanel>
                                        <!-- Header: cover/avatar + title + status badge -->
                                        <Border Style="{StaticResource BookCardHeader}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Cover thumbnail if available -->
                                                <Grid Width="48" Height="64" VerticalAlignment="Center">
                                                    <Border CornerRadius="4" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CoverPath}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border CornerRadius="4" ClipToBounds="True">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CoverPath}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <ui:InfoBadge Grid.Column="2" VerticalAlignment="Top">
                                                    <ui:InfoBadge.Style>
                                                        <Style TargetType="ui:InfoBadge">
                                                            <Setter Property="Value" Value="✓"/>
                                                            <Setter Property="Severity" Value="Success"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasViMd}" Value="False">
                                                                    <Setter Property="Value" Value="…"/>
                                                                    <Setter Property="Severity" Value="Caution"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:InfoBadge.Style>
                                                </ui:InfoBadge>
                                            </Grid>
                                        </Border>

                                        <!-- Progress bar + percentage -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                                         Style="{StaticResource GlassProgressBar}" Height="7" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"
                                                       FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        </Grid>

                                        <!-- Stat tiles: Chunks / EPUB / Audio (Fluent Icons) -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource StatTile}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="16"
                                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ProgressCount, StringFormat={}{0}}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    <TextBlock Text="Chunks" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource StatTile}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Book24" FontSize="16"
                                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding HasEpub, Converter={StaticResource BoolToEmojiConverter}}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    <TextBlock Text="EPUB" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4" Style="{StaticResource StatTile}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Headphones24" FontSize="16"
                                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Mp3Count}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    <TextBlock Text="Audio" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Appearance="Primary" Content="Đọc sách" Icon="{ui:SymbolIcon BookOpen24}" FontSize="12"
                                                       HorizontalAlignment="Stretch"
                                                       ToolTip="Mở Trình đọc E-Reader (hỗ trợ Thuần Việt, Song song 2 cột, Tam ngữ)"
                                                       Command="{Binding DataContext.PreviewTranslatedCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Grid.Column="2" Content="" Icon="{ui:SymbolIcon Folder24}"
                                                       ToolTip="Mở thư mục sách trong Windows Explorer" Width="38"
                                                       Command="{Binding DataContext.OpenBookFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                       CommandParameter="{Binding}"/>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>