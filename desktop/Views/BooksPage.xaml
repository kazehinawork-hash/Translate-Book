<Page x:Class="TranslateBook.Views.BooksPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:TranslateBook.Models"
        Loaded="Page_Loaded"
        ScrollViewer.CanContentScroll="False">

    <Grid Margin="12,8,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Danh sách sách" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Tìm kiếm..."
                                Icon="{ui:SymbolIcon Search24}" IconPlacement="Left"
                                TextChanged="SearchBox_TextChanged" Margin="20,0,0,0" Height="36"
                                Style="{StaticResource InteractiveTextBox}"/>
                    <ui:Button Grid.Column="1" Width="36" Height="36"
                               Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Làm mới" Cursor="Hand"
                               Background="Transparent" BorderThickness="0" Margin="8,0,0,0"
                               Command="{Binding RefreshBooksCommand}"/>
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Glass 3.0 tab headers container -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="4" HorizontalAlignment="Left"
                    Background="{DynamicResource GlassElementBackground2Brush}"
                    BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                    CornerRadius="14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabInput" Content="Input (Chưa dịch)" IsChecked="True"
                                 Click="TabInput_Click" GroupName="BookTabs" Margin="0,0,4,0"
                                 Style="{StaticResource GlassTabHeader}"/>
                    <RadioButton x:Name="TabOutput" Content="Output (Đã dịch)"
                                 Click="TabOutput_Click" GroupName="BookTabs"
                                 Style="{StaticResource GlassTabHeader}"/>
                </StackPanel>
            </Border>

            <!-- Input Book List Container with elegant rounded glass border -->
            <Border Grid.Row="1" x:Name="InputPanel" Visibility="Visible"
                    Background="{DynamicResource GlassElementBackground2Brush}"
                    BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                    CornerRadius="12" Padding="8" Margin="0,0,0,8">
                <ScrollViewer x:Name="InputScrollViewer" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InputBooks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="📚" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Chưa có sách nào để dịch."
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Copy file .pdf, .epub hoặc .docx vào thư mục input/ rồi bấm Làm mới."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,16"/>
                            <ui:Button Content="Mở thư mục input" Icon="{ui:SymbolIcon Folder24}"
                                       HorizontalAlignment="Center" Padding="16,6" Cursor="Hand"
                                       Click="OpenInputFolder_Click"/>
                        </StackPanel>
                        <ItemsControl x:Name="InputItemsControl" ItemsSource="{Binding InputBooks}" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel MaxWidth="{Binding ActualWidth, ElementName=InputScrollViewer}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:BookStatus}">
                                <ui:Card Margin="6" Width="300" Padding="16" Style="{StaticResource InteractiveCard}">
                                    <StackPanel>
                                        <!-- Header: avatar + title + status -->
                                        <Border Style="{StaticResource BookCardHeader}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="21"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding InputCategory, StringFormat='Vị trí: input/{0}'}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                                                   Content="Chạy Pipeline" HorizontalAlignment="Stretch"
                                                   ToolTip="Chạy toàn bộ pipeline: Extract → QC → Chunk → Glossary → Translate → QA → Merge → EPUB"
                                                   Command="{Binding DataContext.RunPipelineCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Content" Value="Đang chạy..."/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Content="Chỉ Dịch" Icon="{ui:SymbolIcon DocumentText24}"
                                                       ToolTip="Chỉ dịch sách (Extract → Translate → QA → Merge → EPUB)"
                                                       HorizontalAlignment="Stretch"
                                                       Command="{Binding DataContext.RunTranslateOnlyCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Grid.Column="2" Content="Tạo Audio" Icon="{ui:SymbolIcon Headphones24}"
                                                       ToolTip="Tạo audiobook bằng VieNeu-TTS (cho sách đã dịch)"
                                                       HorizontalAlignment="Stretch"
                                                       Command="{Binding DataContext.RunAudiobookCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                       CommandParameter="{Binding}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,10,0,0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ui:Button Content="Hủy" Icon="{ui:SymbolIcon Dismiss24}" Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" Padding="12,2"
                                                   Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Output Book List Container with elegant rounded glass border -->
            <Border Grid.Row="1" x:Name="OutputPanel" Visibility="Collapsed"
                    Background="{DynamicResource GlassElementBackground2Brush}"
                    BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                    CornerRadius="12" Padding="8" Margin="0,0,0,8">
                <ScrollViewer x:Name="OutputScrollViewer" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OutputBooks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="✅" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Chưa có sách nào được dịch xong."
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Chuyển sang tab Input để bắt đầu dịch sách mới."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                    <ItemsControl x:Name="OutputItemsControl" ItemsSource="{Binding OutputBooks}" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel MaxWidth="{Binding ActualWidth, ElementName=OutputScrollViewer}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:BookStatus}">
                                <ui:Card Margin="6" Width="340" Style="{StaticResource InteractiveCard}">
                                    <StackPanel>
                                        <!-- Header: cover/avatar + title + status badge -->
                                        <Border Style="{StaticResource BookCardHeader}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Cover thumbnail if available -->
                                                <Grid Width="48" Height="64" VerticalAlignment="Center">
                                                    <Border CornerRadius="4" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CoverPath}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border CornerRadius="4" ClipToBounds="True">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CoverPath}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <ui:InfoBadge Grid.Column="2" VerticalAlignment="Top">
                                                    <ui:InfoBadge.Style>
                                                        <Style TargetType="ui:InfoBadge">
                                                            <Setter Property="Value" Value="✓"/>
                                                            <Setter Property="Severity" Value="Success"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasViMd}" Value="False">
                                                                    <Setter Property="Value" Value="…"/>
                                                                    <Setter Property="Severity" Value="Caution"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:InfoBadge.Style>
                                                </ui:InfoBadge>
                                            </Grid>
                                        </Border>

                                        <!-- Progress bar + percentage -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                                         Height="6" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"
                                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,2"/>
                                        </Grid>

                                        <!-- Stat tiles: Chunks / EPUB / Audio (Fluent Icons) -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource StatTile}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="16"
                                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ProgressCount, StringFormat={}{0}}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    <TextBlock Text="Chunks" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource StatTile}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Book24" FontSize="16"
                                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding HasEpub, Converter={StaticResource BoolToEmojiConverter}}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    <TextBlock Text="EPUB" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4" Style="{StaticResource StatTile}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Headphones24" FontSize="16"
                                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Mp3Count}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                    <TextBlock Text="Audio" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:Button Grid.Column="0" Appearance="Primary" Content="Đọc thử" Icon="{ui:SymbolIcon BookOpen24}" FontSize="12"
                                                       HorizontalAlignment="Stretch"
                                                       ToolTip="Xem trước sách đã dịch (kèm nghe audiobook nếu có)"
                                                       Command="{Binding DataContext.OpenEpubPreviewCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                       CommandParameter="{Binding}"/>
                                            <ui:Button Grid.Column="2" Content="" Icon="{ui:SymbolIcon Folder24}"
                                                       ToolTip="Mở thư mục sách trong Windows Explorer" Width="38"
                                                       Command="{Binding DataContext.OpenBookFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                       CommandParameter="{Binding}"/>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>