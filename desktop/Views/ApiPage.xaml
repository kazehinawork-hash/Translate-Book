<Page x:Class="TranslateBook.Views.ApiPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Loaded="Page_Loaded">

    <Grid Margin="12,8,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Cài đặt API" FontSize="26" FontWeight="Bold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,24"/>

        <ui:Card Grid.Row="1" Padding="24" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Nhà cung cấp (Provider)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <ComboBox x:Name="ProviderCombo" Width="250" HorizontalAlignment="Left"
                          SelectedValuePath="Content"
                    SelectedValue="{Binding SelectedProvider, Mode=TwoWay}" Margin="0,0,0,24">
                    <ComboBoxItem Content="gemini"/>
                    <ComboBoxItem Content="deepseek"/>
                    <ComboBoxItem Content="custom"/>
                </ComboBox>

                <TextBlock Text="Mã truy cập (API Key)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <ui:PasswordBox x:Name="ApiKeyBox" Width="400" HorizontalAlignment="Left"
                                PasswordChanged="ApiKeyBox_PasswordChanged"
                                PlaceholderText="••••••••••••••••"/>
                <TextBlock Text="Để trống nếu không muốn đổi mã cũ." FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,24"/>

                <TextBlock Text="Mô hình (Model)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <ui:TextBox x:Name="ModelBox" Width="400" HorizontalAlignment="Left"
                            Text="{Binding ModelInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Base URL (nếu có)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,24,0,8"/>
                <ui:TextBox x:Name="BaseUrlBox" Width="400" HorizontalAlignment="Left"
                            Text="{Binding BaseUrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                    <ui:Button Appearance="Primary" Content="Lưu cấu hình" Icon="{ui:SymbolIcon Save24}"
                               Width="160" Height="42" FontSize="14"
                               Command="{Binding SaveApiConfigCommand}"/>
                    <ui:Button Content="Kiểm tra kết nối" Icon="{ui:SymbolIcon Globe24}"
                               Width="160" Height="42" FontSize="14" Margin="12,0,0,0"
                               Click="TestApi_Click"/>

                    <TextBlock x:Name="ApiStatus" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>