<Page x:Class="TranslateBook.Views.ApiPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Loaded="Page_Loaded"
        ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12,8,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Cài đặt API" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,24"/>

            <ui:Card Grid.Row="1" Padding="24" VerticalAlignment="Top" Style="{StaticResource InteractiveCard}">
            <StackPanel>
                <TextBlock Text="Nhà cung cấp (Provider)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <ComboBox x:Name="ProviderCombo" Width="360" HorizontalAlignment="Left"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding SelectedProvider, Mode=TwoWay}" Margin="0,0,0,24"
                          SelectionChanged="ProviderCombo_SelectionChanged"
                          ToolTip="Chọn cấu hình API đang sử dụng để dịch"
                          Style="{StaticResource GlassComboBox}">
                    <ComboBoxItem Content="⚡ Cấu hình 1 (Tùy chỉnh: CommandCode / OpenAI / Proxy)" Tag="custom_1"/>
                    <ComboBoxItem Content="✨ Cấu hình 2 (Tùy chỉnh: OpenCode Zen / opencode.ai)" Tag="custom_2"/>
                    <ComboBoxItem Content="🚀 Cấu hình 3 (Tùy chỉnh: DeepSeek / Qwen / Claude)" Tag="custom_3"/>
                    <ComboBoxItem Content="🌐 Cấu hình 4 (Tùy chỉnh: API Key dự phòng 1)" Tag="custom_4"/>
                    <ComboBoxItem Content="🔮 Cấu hình 5 (Tùy chỉnh: API Key dự phòng 2)" Tag="custom_5"/>
                    <ComboBoxItem Content="♊ Gemini Trực Tiếp (Google AI Studio)" Tag="gemini"/>
                    <ComboBoxItem Content="🐳 DeepSeek Trực Tiếp (api.deepseek.com)" Tag="deepseek"/>
                </ComboBox>

                <TextBlock Text="Mã truy cập (API Key)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <ui:PasswordBox x:Name="ApiKeyBox" Width="400" HorizontalAlignment="Left"
                                PasswordChanged="ApiKeyBox_PasswordChanged"
                                PlaceholderText="Nhập API key mới..."
                                ToolTip="API key được lưu cục bộ trong cấu hình của ứng dụng"/>
                <TextBlock x:Name="KeyStatusText" Text="Đang kiểm tra API key..." FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,24"/>

                <TextBlock Text="Mô hình (Model)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <ComboBox x:Name="ModelBox" Width="360" HorizontalAlignment="Left"
                              IsEditable="True"
                              ItemsSource="{Binding AvailableModels}"
                              Text="{Binding ModelInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Chọn model từ danh sách hoặc nhập tên model tùy chỉnh"
                              Style="{StaticResource GlassComboBox}"/>
                    <ui:Button Content="[↻] Quét" Width="80" Height="34" Margin="8,0,0,0"
                               ToolTip="Quét lại danh sách Model hỗ trợ từ API key"
                               Style="{StaticResource GlassPlainButton}"
                               Click="FetchModels_Click"/>
                </StackPanel>
                <TextBlock Text="Ví dụ: gemini-3.6-flash, deepseek-chat, gpt-4o-mini..." FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,24"/>

                <TextBlock Text="Địa chỉ máy chủ (Base URL)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <ui:TextBox x:Name="BaseUrlBox" Width="400" HorizontalAlignment="Left"
                            Text="{Binding BaseUrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Để trống nếu dùng mặc định" Margin="0,0,0,0"
                            ToolTip="Địa chỉ endpoint API tùy chỉnh nếu sử dụng dịch vụ trung gian"/>
                <TextBlock Text="Chỉ cần khi dùng API trung gian hoặc tự host (Local/Ollama)." FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,24"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Appearance="Primary" Style="{StaticResource InteractiveButton}" Content="Lưu cấu hình" Height="36" Padding="18,0"
                               Icon="{ui:SymbolIcon Save24}"
                               Click="SaveConfig_Click"/>
                    <ui:Button Style="{StaticResource InteractiveButton}" Content="Kiểm tra kết nối" Margin="12,0,0,0" Height="36" Padding="18,0"
                               Icon="{ui:SymbolIcon CheckmarkCircle24}"
                               Click="TestApi_Click"/>

                    <TextBlock x:Name="ApiStatus" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>
        </Grid>
    </ScrollViewer>
</Page>