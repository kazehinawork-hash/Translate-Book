<Page x:Class="TranslateBook.Views.ApiPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Loaded="Page_Loaded"
        ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12,8,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Cài đặt API" FontSize="26" FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,24"/>

            <ui:Card Grid.Row="1" Padding="24" VerticalAlignment="Top" Style="{StaticResource InteractiveCard}">
            <StackPanel>
                <TextBlock Text="Nhà cung cấp (Provider)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <ComboBox x:Name="ProviderCombo" Width="250" HorizontalAlignment="Left"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding SelectedProvider, Mode=TwoWay}" Margin="0,0,0,24"
                          ToolTip="Chọn nhà cung cấp API đang sử dụng"
                          Style="{StaticResource GlassComboBox}">
                    <ComboBoxItem Content="gemini"/>
                    <ComboBoxItem Content="deepseek"/>
                    <ComboBoxItem Content="custom"/>
                </ComboBox>

                <TextBlock Text="Mã truy cập (API Key)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <ui:PasswordBox x:Name="ApiKeyBox" Width="400" HorizontalAlignment="Left"
                                PasswordChanged="ApiKeyBox_PasswordChanged"
                                PlaceholderText="Nhập API key mới hoặc để trống để giữ nguyên"
                                ToolTip="API key được lưu cục bộ trong cấu hình của ứng dụng"/>
                <TextBlock Text="Để trống nếu không muốn đổi mã cũ." FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,24"/>

                <TextBlock Text="Mô hình (Model)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <ComboBox x:Name="ModelBox" Width="360" HorizontalAlignment="Left"
                              IsEditable="True"
                              ItemsSource="{Binding AvailableModels}"
                              Text="{Binding ModelInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Chọn mô hình có sẵn trong danh sách hoặc gõ tên mô hình tùy ý"
                              Style="{StaticResource GlassComboBox}"/>
                    <Button Width="34" Height="34" Margin="6,0,0,0" Style="{StaticResource GlassIconButton}"
                            ToolTip="Quét trực tiếp danh sách Model từ API Key"
                            Click="FetchModels_Click">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                    </Button>
                </StackPanel>

                <TextBlock Text="Base URL (nếu có)" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,24,0,8"/>
                <ui:TextBox x:Name="BaseUrlBox" Width="400" HorizontalAlignment="Left"
                            Style="{StaticResource InteractiveTextBox}"
                            PlaceholderText="Ví dụ: https://api.deepseek.com/v1"
                            Text="{Binding BaseUrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                    <ui:Button Appearance="Primary" Style="{StaticResource InteractiveButton}" Content="Lưu cấu hình" Icon="{ui:SymbolIcon Save24}"
                               Width="160" Height="42" FontSize="14"
                               Command="{Binding SaveApiConfigCommand}"/>
                    <ui:Button Style="{StaticResource InteractiveButton}" Content="Kiểm tra kết nối" Icon="{ui:SymbolIcon Globe24}"
                               Width="160" Height="42" FontSize="14" Margin="12,0,0,0"
                               Click="TestApi_Click"/>

                    <TextBlock x:Name="ApiStatus" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- ============== 🧪 DEMO DỊCH THỬ (Luồng 2 - UI + API) ============== -->
        <ui:Card Grid.Row="2" Padding="24" Margin="0,16,0,0" VerticalAlignment="Top" Style="{StaticResource InteractiveCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="🧪" FontSize="22" Margin="0,0,8,0"/>
                    <TextBlock Text="Demo dịch thử (Luồng 2 - UI + API)" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    Bấm 1 trong 3 nút bên dưới để dịch thử 1 câu mẫu qua API hiện tại.
                    Dùng để thí điểm Luồng 2 (UI + API) so với Luồng 1 (Agent chat).
                    Tốn khoảng 20-80 token / lần, gần như miễn phí.
                </TextBlock>

                <TextBlock Text="Text nguồn:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ui:TextBox x:Name="DemoSourceBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                            Style="{StaticResource InteractiveTextBox}"
                            ToolTip="Nhập text muốn dịch thử (mặc định có sẵn ở 3 nút bên dưới)"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Style="{StaticResource InteractiveButton}" Content="🌐 Anh → Việt" Icon="{ui:SymbolIcon Globe24}"
                               Height="40" Padding="14,0" FontSize="13" Click="DemoEnVi_Click"
                               Tag="en|Hello, how are you today? I hope you are doing well. This is a sample sentence for testing translation quality."/>
                    <ui:Button Style="{StaticResource InteractiveButton}" Content="🇨🇳 Trung → Việt" Icon="{ui:SymbolIcon Translate24}"
                               Height="40" Padding="14,0" FontSize="13" Margin="8,0,0,0" Click="DemoZhVi_Click"
                               Tag="zh|在这个快节奏的时代,我们常常忘记停下脚步,倾听内心的声音。"/>
                    <ui:Button Style="{StaticResource InteractiveButton}" Content="🇻🇳 Việt → Anh" Icon="{ui:SymbolIcon ArrowSwap24}"
                               Height="40" Padding="14,0" FontSize="13" Margin="8,0,0,0" Click="DemoViEn_Click"
                               Tag="vi|Cuộc sống là những chuyến đi dài, mỗi trải nghiệm đều là một bài học quý giá."/>
                </StackPanel>

                <TextBlock Text="Kết quả dịch:" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Border BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.5"
                        CornerRadius="6" Background="{DynamicResource GlassElementBackground2Brush}" Padding="10">
                    <ui:TextBox x:Name="DemoResultBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                IsReadOnly="True" Style="{StaticResource InteractiveTextBox}"
                                Background="Transparent" BorderThickness="0"/>
                </Border>

                <TextBlock x:Name="DemoStatsText" FontSize="11" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="(Bấm nút ở trên để dịch thử — chưa có kết quả)"/>
            </StackPanel>
        </ui:Card>
        </Grid>
    </ScrollViewer>
</Page>