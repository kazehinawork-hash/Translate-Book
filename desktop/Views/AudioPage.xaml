<Page x:Class="TranslateBook.Views.AudioPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:TranslateBook.Models"
        Loaded="Page_Loaded"
        ScrollViewer.CanContentScroll="False">

    <Grid Margin="12,8,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header & Main Audio Config Pill Panel -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,12"
                Background="{DynamicResource GlassElementBackground2Brush}"
                BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                CornerRadius="12">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                        <ui:SymbolIcon Symbol="Headphones24" FontSize="18" Margin="0,0,8,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                        <TextBlock Text="Cấu hình Audiobook (VieNeu-TTS Turbo)" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Background="{DynamicResource GlassElementBackgroundBrush}"
                                BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                                CornerRadius="8" Padding="10,4" Margin="0,0,6,6">
                            <CheckBox Content="GPU RTX (--gpu)" IsChecked="{Binding AudioUseGpu}" FontSize="11.5" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{DynamicResource GlassElementBackgroundBrush}"
                                BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                                CornerRadius="8" Padding="10,4" Margin="0,0,6,6">
                            <CheckBox Content="Nhạc nền AI" IsChecked="{Binding AudioMusicAuto}" FontSize="11.5" FontWeight="SemiBold"/>
                        </Border>
                        <Button Height="28" Padding="8,0" FontSize="11" Style="{StaticResource GlassPlainButton}" Margin="0,0,0,6"
                                ToolTip="Khôi phục toàn bộ thông số về chuẩn dự án (GPU RTX, Batch 16, Nhạc 15%, Temp 0.3, Top-K 10)"
                                Command="{Binding ResetAudioConfigCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="12" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,4,0"/>
                                <TextBlock Text="Chuẩn dự án" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>

                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Độ sáng tạo" FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <ui:NumberBox Width="105" Height="30" FontSize="11.5" Value="{Binding AudioTemperature, Mode=TwoWay}"
                                      Minimum="0" Maximum="2" SmallChange="0.1" ToolTip="Giá trị thấp cho giọng đọc ổn định hơn"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Top-K" FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <ui:NumberBox Width="105" Height="30" FontSize="11.5" Value="{Binding AudioTopK, Mode=TwoWay}"
                                      Minimum="1" Maximum="100" SmallChange="1" ToolTip="Giá trị thấp cho cách đọc nhất quán hơn"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Chất lượng MP3" FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox Width="110" Height="30" FontSize="11.5" SelectedValue="{Binding AudioBitrate, Mode=TwoWay}" SelectedValuePath="Content"
                                  Style="{StaticResource GlassComboBox}">
                            <ComboBoxItem Content="96k"/>
                            <ComboBoxItem Content="128k"/>
                            <ComboBoxItem Content="192k"/>
                            <ComboBoxItem Content="256k"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Batch Size (GPU)" FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <ui:NumberBox Width="115" Height="30" FontSize="11.5" Value="{Binding AudioBatchSize, Mode=TwoWay}"
                                      Minimum="1" Maximum="64" SmallChange="2" ToolTip="Chuẩn GPU RTX 3060: 16 (tăng tốc 2x)"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Âm lượng nhạc nền" FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                        <ui:NumberBox Width="120" Height="30" FontSize="11.5" Value="{Binding AudioMusicVolume, Mode=TwoWay}"
                                      Minimum="0.0" Maximum="1.0" SmallChange="0.05" ToolTip="Chuẩn: 0.15 (nhạc lofi êm dịu dưới giọng đọc)"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <CheckBox Content="Đọc tiêu đề" IsChecked="{Binding AudioReadTitles}" FontSize="11.5" Margin="0,0,10,6"/>
                        <CheckBox Content="Gộp 1 MP3" IsChecked="{Binding AudioMergeChapters}" FontSize="11.5" Margin="0,0,10,6"/>
                        <CheckBox Content="Tạo lại (--force)" IsChecked="{Binding AudioForceRegenerate}" FontSize="11.5" Margin="0,0,0,6"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Voice Management Section — Dual Adaptive Glass Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Card 1: Quản lý giọng đọc -->
            <Border Grid.Column="0" Padding="14,12"
                    Background="{DynamicResource GlassElementBackground2Brush}"
                    BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                    CornerRadius="12">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Speaker224" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <TextBlock Text="Quản lý giọng đọc" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Width="26" Height="26" Style="{StaticResource GlassIconButton}"
                                ToolTip="Tải lại danh sách giọng" Command="{Binding LoadVoicesCommand}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="13"/>
                        </Button>
                    </DockPanel>
                    
                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Đặt chính" FontSize="11" Height="28" Padding="8,0" Margin="4,0,4,0"
                                    Style="{StaticResource GlassPlainButton}" Command="{Binding SetActiveVoiceCommand}"/>
                            <Button Width="28" Height="28" Style="{StaticResource GlassIconButton}"
                                    ToolTip="Nghe thử giọng đọc" Command="{Binding PreviewVoiceCommand}">
                                <ui:SymbolIcon Symbol="Play24" FontSize="13" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Button>
                        </StackPanel>
                        <ComboBox Height="28" FontSize="11.5" ItemsSource="{Binding VoiceList}"
                                  SelectedItem="{Binding SelectedVoice}" Margin="0,0,2,0"
                                  Style="{StaticResource GlassComboBox}"/>
                    </DockPanel>
                    
                    <ui:TextBox Style="{StaticResource InteractiveTextBox}" Height="28" FontSize="11"
                                PlaceholderText="Nhập câu đọc thử giọng..."
                                Text="{Binding VoicePreviewText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Clone giọng mới -->
            <Border Grid.Column="2" Padding="14,12"
                    Background="{DynamicResource GlassElementBackground2Brush}"
                    BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                    CornerRadius="12">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="MicSparkle24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <TextBlock Text="Clone giọng mới" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="{DynamicResource GlassElementBackgroundBrush}"
                                BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3"
                                CornerRadius="4" Padding="6,1">
                            <TextBlock Text="3-8s audio" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </DockPanel>
                    
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Style="{StaticResource InteractiveTextBox}" Height="28" FontSize="11" PlaceholderText="Tên giọng..."
                                    Text="{Binding VoiceName, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Column="2" Height="28" FontSize="11" SelectedValue="{Binding VoiceGender, Mode=TwoWay}" SelectedValuePath="Tag"
                                  ToolTip="Giới tính giọng" Style="{StaticResource GlassComboBox}">
                            <ComboBoxItem Content="Nữ" Tag="female"/>
                            <ComboBoxItem Content="Nam" Tag="male"/>
                        </ComboBox>
                    </Grid>
                    
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Trích xuất" Height="28" Padding="10,0" FontSize="11" Margin="6,0,0,0"
                                Style="{StaticResource GlassPlainButton}" Command="{Binding ExtractVoiceCommand}"/>
                        <ui:TextBox Style="{StaticResource InteractiveTextBox}" Height="28" FontSize="11" PlaceholderText="Mô tả giọng (tùy chọn)..."
                                    Text="{Binding VoiceDescription, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Book List Container with elegant rounded glass border -->
        <Border Grid.Row="2"
                Background="{DynamicResource GlassElementBackground2Brush}"
                BorderBrush="{DynamicResource GlassElementBorderBrush}" BorderThickness="0.3,0.3,0.3,1"
                CornerRadius="12" Padding="8" Margin="0,0,0,8">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OutputBooks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🎧" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Chưa có sách nào để tạo Audio."
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Hãy dịch sách tại tab Sách trước khi tạo Audiobook."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" FontSize="14"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <ItemsControl ItemsSource="{Binding OutputBooks}" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:BookStatus}">
                                <ui:Card Margin="6" Width="330" Padding="14" Style="{StaticResource InteractiveCard}">
                                    <StackPanel>
                                        <!-- Header: Avatar + Title -->
                                        <Border Style="{StaticResource BookCardHeader}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="20"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="Audio: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Mp3Count, StringFormat='{}{0} chapters', Mode=OneWay}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,10,0"/>
                                                        <Border Background="{DynamicResource GlassButtonNormalBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="MicSparkle24" FontSize="11" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,3,0"/>
                                                                <TextBlock Text="van_tinh" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Chapter progress while generating (GlassProgressBar đồng bộ phong cách tab Sách) -->
                                        <Grid Margin="0,8,0,8">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Progress header -->
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AudioProgressPercent, StringFormat={}{0:F0}%}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            </Grid>

                                            <!-- Glowing Glass Progress Bar -->
                                            <ProgressBar Grid.Row="1" Value="{Binding AudioProgressPercent, Mode=OneWay}" Maximum="100"
                                                         Style="{StaticResource GlassProgressBar}" Height="7"/>

                                            <!-- Sub details / Step & Chapter counter -->
                                            <TextBlock Grid.Row="2" Text="{Binding BusyDetailText}"
                                                       FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </Grid>

                                        <ui:TextBox PlaceholderText="Chương (VD: 1 2 3 hoặc để trống = tất cả)"
                                                    Text="{Binding ChapterInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource InteractiveTextBox}"
                                                    Margin="0,6,0,0" Height="28" FontSize="11"/>

                                        <!-- Cặp nút Tạo Audio Toàn bộ & Sửa chữa / Rà soát Audio tương tự tab Sách -->
                                        <StackPanel Margin="0,10,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:Button Grid.Column="0" Appearance="Primary" Content="Tạo Audio Toàn bộ"
                                                           Icon="{ui:SymbolIcon Headphones24}" Height="34" FontSize="12"
                                                           ToolTip="Tạo mới toàn bộ Audiobook từ đầu (xóa cache và tạo lại toàn bộ các chương)"
                                                           Command="{Binding DataContext.GenerateFullAudiobookCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                           CommandParameter="{Binding}">
                                                    <ui:Button.Style>
                                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                    <Setter Property="Content" Value="Đang tạo..."/>
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:Button.Style>
                                                </ui:Button>
                                                <Button Grid.Column="2" Width="34" Height="34"
                                                        Style="{StaticResource GlassIconButton}"
                                                        ToolTip="Nghe thử mẫu ~30s giọng đọc &amp; nhạc nền AI"
                                                        Command="{Binding DataContext.GenerateSampleCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                        CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Play24" FontSize="15" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                </Button>
                                                <Button Grid.Column="4" Width="34" Height="34"
                                                        Style="{StaticResource GlassIconButton}"
                                                        ToolTip="Mở thư mục Audiobook (MP3)"
                                                        Command="{Binding DataContext.OpenAudioFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                        CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Folder24" FontSize="15"/>
                                                </Button>
                                            </Grid>

                                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Wrench24}" Margin="0,6,0,0"
                                                       Content="Sửa chữa &amp; Rà soát Audio" Height="34" HorizontalAlignment="Stretch"
                                                       ToolTip="Chế độ thông minh: Rà soát các chương đã có MP3, giữ lại chương chuẩn, chỉ tạo tiếp các chương còn thiếu hoặc bị lỗi"
                                                       Command="{Binding DataContext.GenerateAudiobookCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                       CommandParameter="{Binding}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                <Setter Property="Content" Value="Đang rà soát..."/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                        </StackPanel>

                                        <ui:Button Content="Hủy tạo" Icon="{ui:SymbolIcon Dismiss24}"
                                                   Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                   CommandParameter="{Binding}" Margin="0,6,0,0" HorizontalAlignment="Center" Padding="12,2">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>