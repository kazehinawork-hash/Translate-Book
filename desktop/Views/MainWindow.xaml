<ui:FluentWindow x:Class="TranslateBook.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:TranslateBook.ViewModels"
        xmlns:views="clr-namespace:TranslateBook.Views"
        Title="Translate Book" Width="1100" Height="750" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Acrylic" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round"
        Background="Transparent">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel/>
    </ui:FluentWindow.DataContext>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RefreshBooksCommand}"/>
        <KeyBinding Key="Oem2" Modifiers="Ctrl" Command="{Binding ToggleLogCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RunPipelineFirstBookCommand}"/>
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Translate Book" Icon="{ui:SymbolIcon Library24}">
            <ui:TitleBar.Header>
                <ui:TextBox x:Name="GlobalSearchBox" Width="260" Height="30" Margin="16,0,0,0"
                            PlaceholderText="Tìm kiếm toàn bộ... (Enter để tìm)"
                            Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="GlobalSearch_KeyDown"
                            Style="{StaticResource InteractiveTextBox}"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Unified Glass Container: Left Nav + Book Content + Realtime Log seamlessly connected in 1 single frame -->
        <Border x:Name="MainGlassContainer" Grid.Row="1" Margin="8,0,8,8" CornerRadius="12" ClipToBounds="True"
                BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="1"
                Background="{DynamicResource GlassBackgroundBrush}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Width="{Binding ActualWidth, ElementName=MainGlassContainer}"
                                Height="{Binding ActualHeight, ElementName=MainGlassContainer}"
                                CornerRadius="12" Background="Black"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Nav + Main Page Content -->
                <ui:NavigationView Grid.Column="0" x:Name="NavView"
                                   IsPaneOpen="True" OpenPaneLength="210" PaneDisplayMode="Left"
                                   Margin="0"
                                   Background="Transparent">
                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem Content="Sách" IsActive="True"
                                               TargetPageType="{x:Type views:BooksPage}"
                                               Icon="{ui:SymbolIcon BookOpen24}"/>
                        <ui:NavigationViewItem Content="Audio" TargetPageType="{x:Type views:AudioPage}"
                                               Icon="{ui:SymbolIcon Headphones24}"/>
                    </ui:NavigationView.MenuItems>
                    <ui:NavigationView.FooterMenuItems>
                        <ui:NavigationViewItem IsHitTestVisible="False">
                            <StackPanel Margin="0,6">
                                <TextBlock Text="API" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.8"/>
                                <TextBlock Text="{Binding ActiveProvider, Mode=OneWay}" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Cài đặt" TargetPageType="{x:Type views:ApiPage}"
                                               Icon="{ui:SymbolIcon Settings24}"/>
                    </ui:NavigationView.FooterMenuItems>
                </ui:NavigationView>

                <!-- Realtime Log — right docked panel with Smooth Expand/Collapse Animation -->
                <Border Grid.Column="1" x:Name="LogPanel" Margin="0"
                        BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="1,0,0,0"
                        Background="{DynamicResource GlassBackgroundBrush}"
                        ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="300"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogExpanded}" Value="False">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="36" Duration="0:0:0.25" DecelerationRatio="0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="300" Duration="0:0:0.25" DecelerationRatio="0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- Expanded View -->
                        <Grid x:Name="LogExpandedArea">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Opacity" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Panel header: toggle + title + filter + clear + copy -->
                            <Border Grid.Row="0" Background="{DynamicResource GlassElementBackground2Brush}" Padding="8,6"
                                    BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Width="26" Height="26" Cursor="Hand"
                                            Style="{StaticResource GlassIconButton}"
                                            ToolTip="Thu Realtime Log (Ctrl+/)"
                                            Command="{Binding ToggleLogCommand}">
                                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14"/>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="Realtime Log" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <ui:TextBox x:Name="LogFilterBox" Grid.Column="2" Margin="8,0,6,0" Height="26"
                                                PlaceholderText="Lọc..." Style="{StaticResource InteractiveTextBox}" FontSize="11"
                                                Text="{Binding LogFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextChanged="LogFilterBox_TextChanged"/>
                                    <Button Grid.Column="3" Content="Xóa" FontSize="11" Padding="8,3" Height="26" Cursor="Hand"
                                            Style="{StaticResource GlassPlainButton}" Margin="0,0,4,0"
                                            Click="ClearLogButton_Click"/>
                                    <Button Grid.Column="4" Width="26" Height="26" Cursor="Hand"
                                            Style="{StaticResource GlassIconButton}"
                                            ToolTip="Sao chép toàn bộ log" Click="CopyLogButton_Click">
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">
                                <RichTextBox x:Name="LogBox" Style="{StaticResource LogRichTextBox}"
                                             FontFamily="Consolas" FontSize="11"
                                             TextChanged="LogTextBox_TextChanged"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Collapsed View Button -->
                        <Grid x:Name="LogCollapsedArea">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Button Width="26" Height="32" Cursor="Hand"
                                    Style="{StaticResource GlassCollapseButton}"
                                    ToolTip="Mở Realtime Log (Ctrl+/)"
                                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Command="{Binding ToggleLogCommand}">
                                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,12,12"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="380"/>

        <!-- Busy overlay: shown while any long-running operation is active -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#80000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusyAny}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="56" Height="56"
                                 HorizontalAlignment="Center" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                <TextBlock Text="{Binding BusyMessage}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap"/>
                <ui:Button Content="Hủy thao tác" Icon="{ui:SymbolIcon Dismiss24}" Margin="0,14,0,0"
                           Padding="18,6" HorizontalAlignment="Center" Cursor="Hand"
                           Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
