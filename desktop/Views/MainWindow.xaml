<Window x:Class="TranslateBook.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TranslateBook.ViewModels"
        xmlns:models="clr-namespace:TranslateBook.Models"
        Title="Translate Book" Width="1100" Height="750" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgAppBrush}"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    

    <Grid>
        

        <Border x:Name="RootBorder" Background="{DynamicResource BgAppBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Translate Book" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="16,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#xE921;" Click="Minimize_Click" Style="{StaticResource TitleBarButton}" WindowChrome.IsHitTestVisibleInChrome="True" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                        <Button Content="&#xE922;" Click="Maximize_Click" Style="{StaticResource TitleBarButton}" WindowChrome.IsHitTestVisibleInChrome="True" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                        <Button Content="&#xE8BB;" Click="Close_Click" Style="{StaticResource TitleBarCloseButton}" WindowChrome.IsHitTestVisibleInChrome="True" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar — clearest glass layer, right-edge specular border -->
                    <Border Grid.Column="0" BorderThickness="0,0,1,0">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#60FFFFFF" Offset="0"/>
                                <GradientStop Color="#30FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#08FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#28FFFFFF" Offset="0"/>
                                <GradientStop Color="#15FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Direction="0" ShadowDepth="3" BlurRadius="12" Opacity="0.2" Color="Black"/>
                        </Border.Effect>
                        <StackPanel Margin="8,16">
                            <TextBlock Text="Translate Book" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="12,0,0,20"/>

                            <RadioButton x:Name="NavBooks" Content="  Sách" IsChecked="True"
                                         Style="{StaticResource SidebarButton}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAudio" Content="  Audio"
                                         Style="{StaticResource SidebarButton}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavApi" Content="  API Settings"
                                         Style="{StaticResource SidebarButton}" Checked="Nav_Checked"/>

                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0">
                                    <Run Text="API: "/>
                                    <Run Text="{Binding ActiveProvider, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Content -->
                    <Grid Grid.Column="1" Margin="24,16">
                        <!-- Books Page -->
                        <Grid x:Name="BooksPage" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Danh sách sách" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Style="{StaticResource GlassCard}" CornerRadius="16" Padding="12,0" VerticalAlignment="Center" Height="32">
                                    <Grid>
                                        <TextBlock Text="&#xE71E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                 VerticalAlignment="Center" Margin="24,0,32,0" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                 TextChanged="SearchBox_TextChanged"/>
                                        <TextBlock Text="Tìm kiếm..." Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="24,0,32,0" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Nút Refresh -->
                                        <Button FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE72C;" 
                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Width="24" Height="24"
                                                ToolTip="Làm mới danh sách" Cursor="Hand"
                                                Command="{Binding RefreshBooksCommand}"/>
                                    </Grid>
                                </Border>

                            </Grid>
                            <TabControl Grid.Row="1" Style="{StaticResource GlassTabControl}">
                                <TabItem Header="Input (Chưa dịch)" Style="{StaticResource GlassTabItem}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InputBooks.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Chưa có sách nào để dịch." 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                                       HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBlock Text="Hãy copy file .pdf, .epub hoặc .docx vào thư mục input/ rồi bấm nút Làm mới (vòng lặp)." 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                                       HorizontalAlignment="Center" FontSize="14"/>
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent" Style="{StaticResource GlassScrollViewer}">
                                            <ItemsControl x:Name="InputItemsControl" ItemsSource="{Binding InputBooks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:BookStatus}">
                                                        <Border Style="{StaticResource GlassCard}" Margin="8" Width="260" Height="210">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Border Grid.Row="0" Background="#1A60CDFF" CornerRadius="4"
                                                                        HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,8">
                                                                    <TextBlock Text="INPUT" FontSize="10" Foreground="#60CDFF" FontWeight="Bold"/>
                                                                </Border>
                                                                <TextBlock Grid.Row="1" Text="{Binding Slug}" FontSize="15" FontWeight="Bold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                                                
                                                                <StackPanel Grid.Row="2">
                                                                    <TextBlock Text="Chưa dịch - đặt vào input/" FontSize="12"
                                                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                                                    <Button HorizontalAlignment="Stretch"
                                                                            ToolTip="Tự động trích xuất, chia đoạn và bắt đầu dịch sách"
                                                                            Command="{Binding DataContext.StartTranslateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource GlassButtonSuccess}">
                                                                                <Setter Property="Content" Value="Bắt đầu dịch"/>
                                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                                        <Setter Property="Content" Value="Đang dịch..."/>
                                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Output (Đã dịch)" Style="{StaticResource GlassTabItem}">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutputBooks.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Chưa có sách nào được dịch xong." 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                                       HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBlock Text="Chuyển sang tab Input để bắt đầu dịch sách mới." 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                                       HorizontalAlignment="Center" FontSize="14"/>
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent" Style="{StaticResource GlassScrollViewer}">
                                            <ItemsControl x:Name="OutputItemsControl" ItemsSource="{Binding OutputBooks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:BookStatus}">
                                                        <Border Style="{StaticResource GlassCard}" Margin="8" Width="260" Height="240">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                
                                                                <StackPanel Grid.Row="0">
                                                                    <TextBlock Text="{Binding Slug}" FontSize="15" FontWeight="Bold" Height="42"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                                    
                                                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="#1A808080"/> <!-- Gray -->
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                                        <Setter Property="Background" Value="#1AE6A23C"/> <!-- Vàng -->
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding HasViMd}" Value="True">
                                                                                        <Setter Property="Background" Value="#1A4CAF50"/> <!-- Xanh -->
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="#808080"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                                            <Setter Property="Foreground" Value="#E6A23C"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding HasViMd}" Value="True">
                                                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                    
                                                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                                                                 Style="{StaticResource GlassProgressBar}" Margin="0,4"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0">
                                                                            <Run Text="EPUB: "/>
                                                                            <Run Text="{Binding HasEpub, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                                            <Run Text="Audio: "/>
                                                                            <Run Text="{Binding Mp3Count, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                
                                                                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                                                    <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="8"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button Grid.Column="0" ToolTip="Dịch tiếp phần còn thiếu"
                                                                                Command="{Binding DataContext.StartTranslateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button" BasedOn="{StaticResource GlassButton}">
                                                                                    <Setter Property="Content" Value="Dịch"/>
                                                                                    <Setter Property="IsEnabled" Value="True"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                                            <Setter Property="Content" Value="Đang dịch..."/>
                                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                        <Button Grid.Column="2" Content="Tạo audio" Style="{StaticResource GlassButtonSuccess}"
                                                                                ToolTip="Tự động tạo Audiobook MP3 từ bản dịch Tiếng Việt"
                                                                                Command="{Binding DataContext.GenerateAudiobookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"/>
                                                                    </Grid>
                                                                    <Button Content="Đọc thử EPUB" Style="{StaticResource GlassButton}"
                                                                            ToolTip="Xem trước định dạng và bản dịch"
                                                                            Click="PreviewEpub_Click"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <!-- Audio Page (hidden) -->
                        <Grid x:Name="AudioPage" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Cấu hình Audio" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Temperature" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding AudioTemperature, UpdateSourceTrigger=PropertyChanged}" Width="100" Style="{StaticResource GlassTextBox}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Top-K" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding AudioTopK, UpdateSourceTrigger=PropertyChanged}" Width="100" Style="{StaticResource GlassTextBox}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                            <Grid Grid.Row="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OutputBooks.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Chưa có sách nào." 
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                </StackPanel>
                                
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent" Style="{StaticResource GlassScrollViewer}">
                                    <ItemsControl ItemsSource="{Binding OutputBooks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:BookStatus}">
                                                <Border Style="{StaticResource GlassCard}" Margin="8" Width="260" Height="160">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <StackPanel Grid.Row="0">
                                                            <TextBlock Text="{Binding Slug}" FontSize="15" FontWeight="Bold" Height="42"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                            
                                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0">
                                                                <Run Text="Audio chapters: "/>
                                                                <Run Text="{Binding Mp3Count, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        
                                                        <Button Grid.Row="1" Command="{Binding DataContext.GenerateAudiobookCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GlassButtonSuccess}">
                                                                    <Setter Property="Content" Value="Tạo / Cập nhật Audio"/>
                                                                    <Setter Property="IsEnabled" Value="True"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                            <Setter Property="Content" Value="Đang xử lý..."/>
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- API Settings Page (hidden) -->
                        <Grid x:Name="ApiPage" Visibility="Collapsed" Margin="8,0,24,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Cài đặt API" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                            
                            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="32" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Nhà cung cấp (Provider)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                        <ComboBox x:Name="ProviderCombo" Width="250" HorizontalAlignment="Left"
                                                  SelectedValue="{Binding SelectedProvider, Mode=TwoWay}"
                                                  Style="{StaticResource GlassComboBox}">
                                            <ComboBoxItem Content="gemini"/>
                                            <ComboBoxItem Content="deepseek"/>
                                            <ComboBoxItem Content="custom"/>
                                        </ComboBox>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                                   FontSize="18" Foreground="#4CAF50" 
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   ToolTip="Đã lưu cấu hình">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsApiOk}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Text="Mã truy cập (API Key)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <PasswordBox x:Name="ApiKeyBox" Width="400" HorizontalAlignment="Left"
                                                 PasswordChanged="ApiKeyBox_PasswordChanged"
                                                 Style="{StaticResource GlassPasswordBox}"/>
                                    <TextBlock Text="Để trống nếu không muốn đổi mã cũ." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,24"/>

                                    <TextBlock Text="Mô hình (Model)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBox x:Name="ModelBox" Width="400" HorizontalAlignment="Left"
                                             Text="{Binding ModelInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBox}"/>
                                             
                                    <TextBlock Text="Base URL (nếu có)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,24,0,8"/>
                                    <TextBox Width="400" HorizontalAlignment="Left"
                                             Text="{Binding BaseUrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBox}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                                        <Button Content="Lưu cấu hình" Style="{StaticResource GlassButtonSuccess}"
                                                Width="160" Height="42" FontSize="14"
                                                Command="{Binding SaveApiConfigCommand}"/>
                                        
                                        <Button Content="Kiểm tra kết nối" Style="{StaticResource GlassButton}"
                                                Width="160" Height="42" FontSize="14" Margin="12,0,0,0"
                                                Click="TestApi_Click"/>
                                        
                                        <!-- Loading Spinner -->
                                        <TextBlock x:Name="ApiSpinner" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                                   Text="&#xE116;" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                   Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                                   RenderTransformOrigin="0.5, 0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="ApiSpinnerRotate" Angle="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>

                                        <TextBlock x:Name="ApiStatus" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Log Panel — glass panel at bottom -->
                <Border Grid.Row="2" Margin="24,0,24,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Background="{DynamicResource BgCardBrush}">
                    <Grid Margin="12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Realtime Log" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}"
                                 TextChanged="LogTextBox_TextChanged"
                                 Style="{StaticResource LogTextBox}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <!-- Toast Notification / Snackbar — glass card floating above content -->
        <Border x:Name="ToastNotification" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,-100"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.25" ShadowDepth="2"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" Y="0"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE73E;" 
                           FontSize="16" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastMessage" Text="Thành công!" Foreground="{DynamicResource TextPrimaryBrush}" 
                           FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
