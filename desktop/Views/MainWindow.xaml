<ui:FluentWindow x:Class="TranslateBook.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:TranslateBook.ViewModels"
        xmlns:views="clr-namespace:TranslateBook.Views"
        Title="Translate Book" Width="1180" Height="780" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Acrylic" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round"
        Background="Transparent"
        AllowDrop="True" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" Drop="Window_Drop">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.DataContext>
        <vm:MainViewModel/>
    </ui:FluentWindow.DataContext>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RefreshBooksCommand}"/>
        <KeyBinding Key="Oem2" Modifiers="Ctrl" Command="{Binding ToggleLogCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RunPipelineFirstBookCommand}"/>
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Translate Book" Icon="{ui:SymbolIcon Library24}">
            <ui:TitleBar.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="GlobalSearchBox" Grid.Column="0" Width="280" Height="30" Margin="16,0,0,0"
                                PlaceholderText="Tìm kiếm sách... (Ctrl+F)"
                                Icon="{ui:SymbolIcon Search24}" IconPlacement="Left"
                                Text="{Binding GlobalSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="GlobalSearch_KeyDown"
                                Style="{StaticResource InteractiveTextBox}"/>
                    <!-- Busy Indicator Badge on TitleBar -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                Visibility="{Binding IsBusyAny, Converter={StaticResource BoolToVisibility}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding BusyMessage}" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Unified Glass Container: Left Nav + Book Content + Realtime Log seamlessly connected in 1 single frame -->
        <Border x:Name="MainGlassContainer" Grid.Row="1" Margin="8,0,8,8" CornerRadius="12" ClipToBounds="True"
                BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="1"
                Background="{DynamicResource GlassBackgroundBrush}">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border Width="{Binding ActualWidth, ElementName=MainGlassContainer}"
                                Height="{Binding ActualHeight, ElementName=MainGlassContainer}"
                                CornerRadius="12" Background="Black"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Nav + Main Page Content (Menu dạng viên thuốc viền gương Glass 3.0 - Cố định) -->
                <ui:NavigationView Grid.Column="0" x:Name="NavView"
                                   IsPaneOpen="True" OpenPaneLength="210"
                                   PaneDisplayMode="Left"
                                   IsBackButtonVisible="Collapsed" IsPaneToggleVisible="False"
                                   Margin="0"
                                   Background="Transparent">

                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem Content="Sách" IsActive="True"
                                               TargetPageType="{x:Type views:BooksPage}"
                                               Icon="{ui:SymbolIcon BookOpen24}"
                                               Style="{StaticResource GlassNavPillItem}"/>
                        <ui:NavigationViewItem Content="Audiobook" TargetPageType="{x:Type views:AudioPage}"
                                               Icon="{ui:SymbolIcon Headphones24}"
                                               Style="{StaticResource GlassNavPillItem}"/>
                    </ui:NavigationView.MenuItems>

                    <ui:NavigationView.FooterMenuItems>
                        <ui:NavigationViewItem IsHitTestVisible="False">
                            <StackPanel Margin="0,6">
                                <TextBlock Text="API" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.8"/>
                                <TextBlock Text="{Binding DisplayActiveProvider, Mode=OneWay}" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:NavigationViewItem>

                        <ui:NavigationViewItem Content="Cài đặt" TargetPageType="{x:Type views:ApiPage}"
                                               Icon="{ui:SymbolIcon Settings24}"
                                               Style="{StaticResource GlassNavPillItem}"/>
                    </ui:NavigationView.FooterMenuItems>
                </ui:NavigationView>

                <!-- Realtime Log — right docked panel with Smooth Expand/Collapse Animation -->
                <Border Grid.Column="1" x:Name="LogPanel" Margin="0"
                        BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="1,0,0,0"
                        Background="{DynamicResource GlassBackgroundBrush}"
                        ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="300"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogExpanded}" Value="False">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="36" Duration="0:0:0.25" DecelerationRatio="0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="300" Duration="0:0:0.25" DecelerationRatio="0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- Expanded View -->
                        <Grid x:Name="LogExpandedArea">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Opacity" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="*"/>
                                 <RowDefinition Height="Auto"/>
                             </Grid.RowDefinitions>

                             <!-- Panel header: Thiết kế 2 tầng chuẩn Glass 3.0 sang trọng & thoáng đãng -->
                             <Border Grid.Row="0" Background="{DynamicResource GlassElementBackground2Brush}" Padding="10,8"
                                     BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="0,0,0,1">
                                 <StackPanel>
                                     <!-- Tầng 1: Tiêu đề + Live Pulse + Bộ nút Action nhanh -->
                                     <Grid Margin="0,0,0,8">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                         </Grid.ColumnDefinitions>

                                         <!-- Bên trái: Live Pulse + Tiêu đề Console -->
                                         <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                             <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,7,0"
                                                     Background="#00F0FF" VerticalAlignment="Center"/>
                                             <TextBlock Text="Realtime Console" FontWeight="Bold" FontSize="12.5"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                         </StackPanel>

                                         <!-- Bên phải: Các nút icon thao tác (Sao chép, Xóa sạch, Thu gọn) -->
                                         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                             <Button Width="28" Height="28" Margin="0,0,4,0" Cursor="Hand"
                                                     Style="{StaticResource GlassIconButton}"
                                                     ToolTip="Sao chép toàn bộ nội dung Log" Click="CopyLogButton_Click">
                                                 <ui:SymbolIcon Symbol="Copy24" FontSize="13"/>
                                             </Button>
                                             <Button Width="28" Height="28" Margin="0,0,6,0" Cursor="Hand"
                                                     Style="{StaticResource GlassIconButton}"
                                                     ToolTip="Xóa sạch màn hình Log" Click="ClearLogButton_Click">
                                                 <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="#FFEF5350"/>
                                             </Button>
                                             
                                             <!-- Nút thu gọn dạng Pill kính mờ sang trọng -->
                                             <Button Width="28" Height="28" Cursor="Hand"
                                                     Style="{StaticResource GlassCollapseButton}"
                                                     ToolTip="Thu gọn bảng Log (Ctrl+/)"
                                                     Command="{Binding ToggleLogCommand}">
                                                 <ui:SymbolIcon Symbol="ChevronRight24" FontSize="13"/>
                                             </Button>
                                         </StackPanel>
                                     </Grid>

                                     <!-- Tầng 2: Thanh tìm kiếm / Lọc log phủ rộng thoáng đãng -->
                                     <ui:TextBox x:Name="LogFilterBox" Height="28"
                                                 PlaceholderText="🔍 Lọc log theo từ khóa..." 
                                                 Style="{StaticResource InteractiveTextBox}" FontSize="11"
                                                 Text="{Binding LogFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="LogFilterBox_TextChanged"/>
                                 </StackPanel>
                             </Border>

                             <!-- Khu vực hiển thị dòng Log Console -->
                             <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1"
                                           VerticalScrollBarVisibility="Auto">
                                 <RichTextBox x:Name="LogBox" Style="{StaticResource LogRichTextBox}"
                                               FontFamily="Consolas" FontSize="11"/>
                             </ScrollViewer>

                             <!-- AI Thinking & Processing Live Status Bar (Hiệu ứng AI đang suy nghĩ) -->
                             <Border Grid.Row="2" Background="#141824" Padding="10,8"
                                     BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="0,1,0,0">
                                 <Border.Style>
                                     <Style TargetType="Border">
                                         <Setter Property="Visibility" Value="Collapsed"/>
                                         <Style.Triggers>
                                             <DataTrigger Binding="{Binding IsBusyAny}" Value="True">
                                                 <Setter Property="Visibility" Value="Visible"/>
                                             </DataTrigger>
                                         </Style.Triggers>
                                     </Style>
                                 </Border.Style>
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="Auto"/>
                                         <ColumnDefinition Width="*"/>
                                         <ColumnDefinition Width="Auto"/>
                                     </Grid.ColumnDefinitions>
                                     
                                     <!-- Thinking Sparkle Icon -->
                                     <ui:SymbolIcon Grid.Column="0" Symbol="Sparkle24" FontSize="15"
                                                    Foreground="#B388FF" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                     <!-- Thinking Title / Busy Status -->
                                     <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                         <TextBlock Text="{Binding BusyMessage, TargetNullValue='AI đang suy nghĩ và dịch thuật ngữ...'}"
                                                    FontSize="11" FontWeight="SemiBold"
                                                    Foreground="#E0E6ED" TextTrimming="CharacterEllipsis"/>
                                     </StackPanel>

                                     <!-- Wave Pulse Progress (Glass 3.0 — viền gương + bo tròn pill) -->
                                     <ProgressBar Grid.Column="2" Width="60" Height="4" IsIndeterminate="True"
                                                  Style="{StaticResource GlassProgressBar}"
                                                  VerticalAlignment="Center"/>
                                 </Grid>
                             </Border>
                        </Grid>

                        <!-- Collapsed View: Nút dải dọc phát sáng thanh thoát -->
                        <Grid x:Name="LogCollapsedArea">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                                <Button Width="26" Height="42" Cursor="Hand"
                                        Style="{StaticResource GlassCollapseButton}"
                                        ToolTip="Mở rộng Realtime Log (Ctrl+/)"
                                        Command="{Binding ToggleLogCommand}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="#00F0FF" Margin="0,0,0,4"/>
                                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Lớp phủ Kính mờ Phát sáng khi Kéo - Thả file sách (Drag & Drop Overlay) -->
        <Grid x:Name="DragDropOverlay" Grid.Row="1" Margin="8,0,8,8" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Background="#D00B0F19" CornerRadius="12" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="40" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Thả file vào đây để thêm sách mới" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Hỗ trợ file .epub, .pdf, .docx — Sẽ tự động lưu vào input/chua-lam/" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,12,12"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="380"/>
    </Grid>
</ui:FluentWindow>
