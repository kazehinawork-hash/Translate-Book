<ui:FluentWindow x:Class="TranslateBook.Views.EpubPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:models="clr-namespace:TranslateBook.Models"
        Title="EPUB Preview" Height="720" Width="1100" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Acrylic" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Đọc thử Sách EPUB" Icon="{ui:SymbolIcon BookOpen24}"/>

        <!-- Toolbar: search, zoom, theme refresh (Glass 3.0) -->
        <Border Grid.Row="1" Background="{DynamicResource GlassBackgroundBrush}" Padding="8,6"
                BorderBrush="{DynamicResource GlassGradientBorderBrush}" BorderThickness="0,0,0,1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left section: Controls & Typography -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnRefreshTheme" Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Width="32" Height="30" Margin="0,0,6,0" Click="BtnRefreshTheme_Click"
                               ToolTip="Cập nhật lại màu sắc theo theme hiện tại"
                               Style="{StaticResource GlassIconButton}"/>

                    <!-- Zoom Slider -->
                    <TextBlock x:Name="ZoomPercent" Text="100%" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,4,0"/>
                    <Slider x:Name="ZoomSlider" Width="70" Minimum="50" Maximum="200" Value="100"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            ValueChanged="ZoomSlider_ValueChanged"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <!-- Typography: Font Selector -->
                    <ComboBox x:Name="CmbFont" Width="155" Height="30" Margin="0,0,6,0" FontSize="11.5"
                              Style="{StaticResource GlassComboBox}"
                              SelectionChanged="CmbFont_SelectionChanged" ToolTip="Chọn kiểu phông chữ">
                        <ComboBoxItem Content="Mặc định (Segoe UI)" IsSelected="True" Tag="'Segoe UI', -apple-system, BlinkMacSystemFont, Arial, sans-serif"/>
                        <ComboBoxItem Content="Có chân (Serif)" Tag="'Merriweather', 'Georgia', 'Times New Roman', serif"/>
                        <ComboBoxItem Content="Bookerly (Kindle)" Tag="'Bookerly', 'Literata', 'Merriweather', 'Georgia', 'Times New Roman', serif"/>
                        <ComboBoxItem Content="Trung - Việt (Noto)" Tag="'Noto Serif SC', 'Noto Serif', 'Georgia', serif"/>
                        <ComboBoxItem Content="Cổ điển (KaiTi)" Tag="'KaiTi', 'STKaiti', 'Cambria', serif"/>
                        <ComboBoxItem Content="Đơn cách (Mono)" Tag="'Consolas', 'Courier New', monospace"/>
                    </ComboBox>

                    <!-- Typography: Width Selector -->
                    <ComboBox x:Name="CmbWidth" Width="115" Height="30" Margin="0,0,6,0" FontSize="11.5"
                              Style="{StaticResource GlassComboBox}"
                              SelectionChanged="CmbWidth_SelectionChanged" ToolTip="Độ rộng lề trang sách">
                        <ComboBoxItem Content="Gọn (650px)" Tag="650px"/>
                        <ComboBoxItem Content="Vừa (800px)" IsSelected="True" Tag="800px"/>
                        <ComboBoxItem Content="Rộng (1000px)" Tag="1000px"/>
                        <ComboBoxItem Content="Toàn màn hình" Tag="95%"/>
                    </ComboBox>

                    <!-- Typography: Line Height -->
                    <ComboBox x:Name="CmbLineHeight" Width="100" Height="30" Margin="0,0,8,0" FontSize="11.5"
                              Style="{StaticResource GlassComboBox}"
                              SelectionChanged="CmbLineHeight_SelectionChanged" ToolTip="Khoảng cách dòng">
                        <ComboBoxItem Content="Dày (1.5x)" Tag="1.5"/>
                        <ComboBoxItem Content="Vừa (1.8x)" IsSelected="True" Tag="1.8"/>
                        <ComboBoxItem Content="Thoáng (2.2x)" Tag="2.2"/>
                    </ComboBox>

                    <!-- Mode Selector -->
                    <ComboBox x:Name="CmbMode" Width="180" Height="30" Margin="0,0,6,0" FontSize="11.5"
                              Style="{StaticResource GlassComboBox}"
                              SelectionChanged="CmbMode_SelectionChanged" ToolTip="Chọn chế độ hiển thị">
                        <ComboBoxItem Content="Bản dịch (Thuần Việt)" IsSelected="True" Tag="vi"/>
                        <ComboBoxItem Content="Tam ngữ (Gốc + Pinyin + Việt)" Tag="tri"/>
                        <ComboBoxItem Content="Song song Đối chiếu (2 Cột)" Tag="split"/>
                        <ComboBoxItem Content="Bản gốc" Tag="src"/>
                    </ComboBox>
                </StackPanel>

                <!-- Right section: Search & Progress -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:TextBox x:Name="SearchBox" Width="160" Height="30" FontSize="11.5" PlaceholderText="Tìm kiếm trong sách..."
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"
                                 Style="{StaticResource InteractiveTextBox}"/>

                    <ui:Button x:Name="BtnSearchPrev" Icon="{ui:SymbolIcon ChevronUp24}"
                               Width="30" Height="30" Margin="4,0,0,0" Click="BtnSearchPrev_Click"
                               ToolTip="Tìm chuỗi trước đó (Shift+Enter)"
                               Style="{StaticResource GlassIconButton}"/>
                    <ui:Button x:Name="BtnSearchNext" Icon="{ui:SymbolIcon ChevronDown24}"
                               Width="30" Height="30" Margin="2,0,0,0" Click="BtnSearchNext_Click"
                               ToolTip="Tìm chuỗi kế tiếp (Enter)"
                               Style="{StaticResource GlassIconButton}"/>

                    <TextBlock x:Name="TxtSearchCount" Text="" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="6,0,0,0"/>

                    <TextBlock x:Name="TxtReadingProgress" Text="" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,4,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180" MaxWidth="600"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="TocTreeView" Grid.Column="0" Background="Transparent" BorderThickness="0"
                      Margin="8" SelectedItemChanged="TocTreeView_SelectedItemChanged"
                      ItemContainerStyle="{StaticResource AppTreeViewItem}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding NestedItems}">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- GridSplitter co kéo độ rộng cột mục lục -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="False">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    Background="{DynamicResource GlassGradientBorderBrush}"/>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Grid Grid.Column="2">
                <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#1E1E1E" NavigationCompleted="WebView_NavigationCompleted" WebMessageReceived="WebView_WebMessageReceived"/>

                <!-- Loading Overlay khi chuyển chế độ đọc -->
                <Border x:Name="LoadingOverlay" Background="#99000000" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,14"/>
                        <TextBlock x:Name="TxtLoadingStatus" Text="Đang xử lý và chuyển chế độ..."
                                   FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Audio Player Bar (Glass 3.0) -->
        <Border x:Name="AudioBar" Grid.Row="3" BorderThickness="0,1,0,0" Padding="16,10" Visibility="Collapsed"
                Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassGradientBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <!-- Track Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="AudioChapterName" Text="Chương 1" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AudioStatus" Text="Audiobook" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Controls and Slider -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="24,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Button FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE892;" Width="36" Height="36" FontSize="14" Margin="0,0,12,0" Click="BtnAudioPrev_Click" ToolTip="Chương trước"
                                Style="{StaticResource GlassPlainButton}"/>
                        <Button x:Name="BtnAudioPlay" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE768;" Width="44" Height="44" FontSize="18" Click="BtnAudioPlayPause_Click" ToolTip="Phát / Tạm dừng"
                                Style="{StaticResource GlassPlainButton}"/>
                        <Button FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE893;" Width="36" Height="36" FontSize="14" Margin="12,0,0,0" Click="BtnAudioNext_Click" ToolTip="Chương sau"
                                Style="{StaticResource GlassPlainButton}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AudioTimeCurrent" Grid.Column="0" Text="00:00" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="AudioSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                Thumb.DragStarted="AudioSlider_DragStarted" Thumb.DragCompleted="AudioSlider_DragCompleted" ValueChanged="AudioSlider_ValueChanged"/>
                        <TextBlock x:Name="AudioTimeTotal" Grid.Column="2" Text="00:00" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Volume -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE767;" FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
