<Window x:Class="TranslateBook.Views.EpubPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:models="clr-namespace:TranslateBook.Models"
        Title="EPUB Preview" Height="700" Width="1000" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgAppBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
            <TextBlock Text="Đọc thử Sách EPUB" Foreground="{DynamicResource TextSecondaryBrush}" 
                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0" FontWeight="SemiBold"/>
                       
            <!-- Window Controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="−" Width="46" Style="{StaticResource GlassButton}"
                        Background="Transparent" BorderThickness="0" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                        Click="BtnMinimize_Click" Cursor="Hand"/>
                
                <Button x:Name="BtnMaximize" Content="☐" Width="46" Style="{StaticResource GlassButton}"
                        Background="Transparent" BorderThickness="0" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                        Click="BtnMaximize_Click" Cursor="Hand"/>
                        
                <Button Content="✕" Width="46" Style="{StaticResource GlassButton}"
                        Background="Transparent" BorderThickness="0" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                        Click="BtnClose_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <TreeView x:Name="TocTreeView" Grid.Column="0" Background="Transparent" BorderThickness="0" 
                      Margin="8" SelectedItemChanged="TocTreeView_SelectedItemChanged"
                      ItemContainerStyle="{StaticResource GlassTreeViewItem}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding NestedItems}">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            
            <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>
            
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <wv2:WebView2 x:Name="WebView" Grid.Row="0" DefaultBackgroundColor="Transparent" NavigationCompleted="WebView_NavigationCompleted" />
            </Grid>
        </Grid>

        <!-- Audio Player Bar -->
        <Border x:Name="AudioBar" Grid.Row="2" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,1,0,0" Padding="16,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                
                <!-- Track Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="AudioChapterName" Text="Chương 1" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AudioStatus" Text="Audiobook" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                
                <!-- Controls and Slider -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="24,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Button FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE892;" Style="{StaticResource GlassButton}" Width="36" Height="36" FontSize="14" Margin="0,0,12,0" Click="BtnAudioPrev_Click" ToolTip="Chương trước"/>
                        <Button x:Name="BtnAudioPlay" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE768;" Style="{StaticResource GlassButtonSuccess}" Width="44" Height="44" FontSize="18" Click="BtnAudioPlayPause_Click" ToolTip="Phát / Tạm dừng"/>
                        <Button FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE893;" Style="{StaticResource GlassButton}" Width="36" Height="36" FontSize="14" Margin="12,0,0,0" Click="BtnAudioNext_Click" ToolTip="Chương sau"/>
                    </StackPanel>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AudioTimeCurrent" Grid.Column="0" Text="00:00" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="AudioSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                Style="{StaticResource {x:Type Slider}}" 
                                Thumb.DragStarted="AudioSlider_DragStarted" Thumb.DragCompleted="AudioSlider_DragCompleted" ValueChanged="AudioSlider_ValueChanged"/>
                        <TextBlock x:Name="AudioTimeTotal" Grid.Column="2" Text="00:00" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Volume -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE767;" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
